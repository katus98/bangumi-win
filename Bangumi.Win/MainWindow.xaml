<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Bangumi.Win.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Bangumi">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView
        x:Name="RootNavigation"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Auto"
        SelectionChanged="RootNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="时间胶囊" Icon="Home" Tag="home" />
            <NavigationViewItem Content="收藏" Icon="Library" Tag="collections" />
            <NavigationViewItem Content="搜索" Icon="Find" Tag="search" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="设置" Icon="Setting" Tag="settings" />
        </NavigationView.FooterMenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="20,12,28,8">
                <Button
                    x:Name="AccountButton"
                    HorizontalAlignment="Right"
                    Click="AccountButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Image x:Name="AccountAvatar" Stretch="UniformToFill" />
                        </Border>
                        <TextBlock x:Name="AccountText" Text="登录" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Frame x:Name="ContentFrame" Grid.Row="1" />
        </Grid>
    </NavigationView>
</Window>
