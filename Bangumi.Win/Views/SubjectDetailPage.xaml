<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bangumi.Win.Views.SubjectDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Image x:Name="BackdropImage" Stretch="UniformToFill" Opacity="0.18" IsHitTestVisible="False" Canvas.ZIndex="0" />
        <Rectangle Fill="{ThemeResource ApplicationPageBackgroundThemeBrush}" Opacity="0.88" IsHitTestVisible="False" Canvas.ZIndex="1" />

        <InfoBar
            x:Name="StatusBar"
            MaxWidth="560"
            Margin="0,0,0,4"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="3"
            IsOpen="False" />

        <ScrollViewer x:Name="DetailScrollViewer" Canvas.ZIndex="2" ViewChanged="DetailScrollViewer_ViewChanged">
            <Grid RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="20" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid x:Name="SubjectHeaderGrid" ColumnSpacing="24" MinHeight="240">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="NarrowHeader">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="0" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="SubjectCoverBorder.(Grid.ColumnSpan)" Value="2" />
                                        <Setter Target="SubjectCoverBorder.HorizontalAlignment" Value="Center" />
                                        <Setter Target="SubjectHeaderContent.(Grid.Row)" Value="1" />
                                        <Setter Target="SubjectHeaderContent.(Grid.Column)" Value="0" />
                                        <Setter Target="SubjectHeaderContent.(Grid.ColumnSpan)" Value="2" />
                                        <Setter Target="SubjectHeaderContent.Margin" Value="0,20,0,0" />
                                        <Setter Target="CollectionStatusButton.(Grid.Row)" Value="1" />
                                        <Setter Target="CollectionStatusButton.(Grid.Column)" Value="0" />
                                        <Setter Target="CollectionStatusButton.HorizontalAlignment" Value="Left" />
                                        <Setter Target="CollectionStatusButton.Margin" Value="0,12,0,0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="WideHeader">
                                    <VisualState.StateTriggers>
                                        <AdaptiveTrigger MinWindowWidth="720" />
                                    </VisualState.StateTriggers>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="SubjectCoverBorder" Width="160" Height="220" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" VerticalAlignment="Center">
                            <Image x:Name="CoverImage" Stretch="UniformToFill" />
                        </Border>

                        <StackPanel x:Name="SubjectHeaderContent" Grid.Column="1" Spacing="14" VerticalAlignment="Center">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="TitleText" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                                <Button x:Name="CollectionStatusButton" Grid.Column="1" MinWidth="108" Padding="14,8" VerticalAlignment="Top" Click="CollectionStatus_Click" />
                            </Grid>
                            <TextBlock x:Name="SubtitleText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Padding="12,6" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock x:Name="TypeBadgeText" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock x:Name="ScoreText" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock x:Name="ProgressHintText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Spacing="30">
                    <StackPanel Spacing="10">
                        <TextBlock Text="章节" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ListView x:Name="EpisodeStatusList" MaxHeight="360" SelectionMode="None" Visibility="Collapsed">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Episode.NumberText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Episode.DisplayName}" TextWrapping="Wrap" />
                                        <Button
                                            Grid.Column="2"
                                            MinWidth="86"
                                            Content="{Binding ActionLabel}"
                                            Background="{Binding ActionBackground}"
                                            Foreground="{Binding ActionForeground}"
                                            Click="EpisodeStatus_Click"
                                            Tag="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="EpisodeEmptyText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="暂无章节信息" />
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="标签" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ItemsControl x:Name="TagsItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,8" Padding="10,6" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Count}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TagsEmptyText" Text="暂无标签" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="简介" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="吐槽" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ListView x:Name="CommentList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4,10" Spacing="4">
                                        <TextBlock Text="{Binding MetaText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="CommentStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
