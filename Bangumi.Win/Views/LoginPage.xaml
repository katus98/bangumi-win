<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bangumi.Win.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="32" RowSpacing="20" MaxWidth="760" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock Text="Bangumi 登录" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="粘贴 Bangumi access token 后会调用 /v0/me 验证，并在本机持久化登录状态。"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <PasswordBox
                x:Name="TokenBox"
                Grid.Row="1"
                Header="Access token"
                PlaceholderText="从 Bangumi 获取的 access token"
                PasswordRevealMode="Peek" />

            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="80" Height="80" CornerRadius="40" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Image x:Name="AvatarImage" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="LoginStateText" Text="未登录" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="NicknameText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="UserMetaText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>

            <CommandBar Grid.Row="3" DefaultLabelPosition="Right" Background="Transparent">
                <AppBarButton Icon="Accept" Label="登录" Click="SignIn_Click" />
                <AppBarButton Icon="Refresh" Label="验证当前登录" Click="Verify_Click" />
                <AppBarButton Icon="Clear" Label="退出登录" Click="SignOut_Click" />
            </CommandBar>

            <InfoBar
                x:Name="StatusBar"
                Grid.Row="4"
                IsOpen="False" />
        </Grid>
    </ScrollViewer>
</Page>
