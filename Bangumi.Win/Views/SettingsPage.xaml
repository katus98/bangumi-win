<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bangumi.Win.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="16">
            <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}" />

            <StackPanel Spacing="8">
                <TextBlock Text="基础设置" FontWeight="SemiBold" />
                <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                    <RadioButtons x:Name="ThemeSelector" Header="应用主题" MaxColumns="3">
                        <x:String>跟随系统</x:String>
                        <x:String>浅色</x:String>
                        <x:String>深色</x:String>
                    </RadioButtons>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="关于" FontWeight="SemiBold" />
                <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                    <StackPanel Spacing="4">
                        <TextBlock Text="番喵" FontWeight="SemiBold" />
                        <TextBlock Text="Windows 11 风格的 Bangumi 第三方客户端。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="本应用与 Bangumi 官方无隶属关系。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="开源信息" FontWeight="SemiBold" />
                <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                    <StackPanel Spacing="8">
                        <TextBlock Text="本项目使用 WinUI 3、Windows App SDK 和 Bangumi API。" TextWrapping="Wrap" />
                        <HyperlinkButton HorizontalAlignment="Left" Content="项目源代码" NavigateUri="https://github.com/katus/bangumi-win" />
                        <HyperlinkButton HorizontalAlignment="Left" Content="Bangumi API 文档" NavigateUri="https://bangumi.github.io/api/" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
