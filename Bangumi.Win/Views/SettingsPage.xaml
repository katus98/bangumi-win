<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bangumi.Win.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="28" Spacing="16">
            <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}" />

            <StackPanel Spacing="8">
                <TextBlock Text="基础设置" FontWeight="SemiBold" />
                <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="跟随系统主题" />
                            <TextBlock Text="应用将使用 Windows 当前主题设置。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="True" OffContent="关" OnContent="开" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="关于" FontWeight="SemiBold" />
                <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Bangumi" FontWeight="SemiBold" />
                        <TextBlock Text="Windows 11 风格的 Bangumi 第三方客户端。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="版本 0.1.0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="开源信息" FontWeight="SemiBold" />
                <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                    <StackPanel Spacing="4">
                        <TextBlock Text="本项目使用 WinUI 3、Windows App SDK 和 Bangumi API。" TextWrapping="Wrap" />
                        <TextBlock Text="Bangumi API 文档：https://bangumi.github.io/api/" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
