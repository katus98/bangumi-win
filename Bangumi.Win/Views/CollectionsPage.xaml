<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bangumi.Win.Views.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="收藏" Style="{ThemeResource TitleTextBlockStyle}" />

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <StackPanel
                x:Name="SubjectTypeTabs"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="8" />
        </ScrollViewer>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
            <StackPanel
                x:Name="CollectionStatusTabs"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="6" />
        </ScrollViewer>

        <InfoBar
            x:Name="StatusBar"
            Grid.RowSpan="4"
            MaxWidth="560"
            Margin="0,0,0,4"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="10"
            IsOpen="False" />

        <ListView
            x:Name="CollectionList"
            Grid.Row="3"
            ContainerContentChanging="CollectionList_ContainerContentChanging"
            ItemClick="CollectionList_ItemClick"
            IsItemClickEnabled="True"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,10" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="64" Height="88" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                            <Image Source="{Binding Subject.ImageUrl}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding Subject.DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Subject.Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding StatusLabel}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding ProgressLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
