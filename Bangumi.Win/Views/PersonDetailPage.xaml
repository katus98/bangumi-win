<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bangumi.Win.Views.PersonDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar DefaultLabelPosition="Right" Background="Transparent">
            <AppBarButton Icon="Back" Label="返回" Click="Back_Click" />
            <AppBarButton Icon="Add" Label="收藏人物" Click="Collect_Click" />
        </CommandBar>

        <Popup x:Name="StatusPopup" IsLightDismissEnabled="False">
            <InfoBar x:Name="StatusBar" MinWidth="320" MaxWidth="720" IsOpen="False" />
        </Popup>

        <ScrollViewer Grid.Row="1">
            <Grid ColumnSpacing="24" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="160" Height="220" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" VerticalAlignment="Top">
                    <Image x:Name="PortraitImage" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock x:Name="NameText" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="CareerText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
